# This .gitignore file should be placed at the root of your Unity project directory

# =====================================================================
# UNITY GENERATED - rebuilt automatically on project open, never commit
# =====================================================================
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/

# =====================================================================
# BUILD OUTPUTS
# =====================================================================
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# =====================================================================
# USER-SPECIFIC IDE / EDITOR STATE - never share these
# =====================================================================
/[Uu]ser[Ss]ettings/
.vs/
.vscode/
.gradle/
*.DotSettings.user
*.suo
*.user
*.userprefs

# =====================================================================
# AUTO-GENERATED SOLUTION / PROJECT FILES - rebuilt by Unity or IDE
# =====================================================================
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# =====================================================================
# UNITY MISC
# =====================================================================
sysinfo.txt
mono_crash.*
crashlytics-build.properties
InitTestScene*.unity*
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Blender backup files (the *.blend itself is fine to commit)
*.blend1
*.blend1.meta

# Log files
*.log

# =====================================================================
# ADDRESSABLES
# =====================================================================
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# =====================================================================
# VISUAL SCRIPTING
# =====================================================================
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# IDE plugins (auto-installed per user)
/[Aa]ssets/Plugins/Editor/JetBrains*

# =====================================================================
# PYTHON - virtual envs and bytecode are machine-local
# =====================================================================
venv/
.venv/
__pycache__/

# TensorBoard event logs (large, local viewer only)
events.out.tfevents.*